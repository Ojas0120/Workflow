        <bpmndi:BPMNLabel><dc:Bounds x="900" y="202" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="915" y="60" />
