      <bpmndi:BPMNShape id="Gateway_Category_di" bpmnElement="Gateway_Category" isMarkerVisible="true">
        <dc:Bounds x="675" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="655" y="250" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Urgent_di" bpmnElement="Task_Urgent">
        <dc:Bounds x="805" y="20" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Urgent_di" bpmnElement="End_Urgent">
        <dc:Bounds x="992" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="965" y="82" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Priority_di" bpmnElement="Task_Priority">
        <dc:Bounds x="805" y="290" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PriorityOutcome_di" bpmnElement="Gateway_PriorityOutcome" isMarkerVisible="true">
        <dc:Bounds x="985" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="965" y="360" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Referred_di" bpmnElement="End_Referred">
        <dc:Bounds x="992" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="965" y="462" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Slots_di" bpmnElement="Task_Slots">
        <dc:Bounds x="1115" y="180" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Slots_di" bpmnElement="Gateway_Slots" isMarkerVisible="true">
        <dc:Bounds x="1295" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1275" y="250" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Book_di" bpmnElement="Task_Book">
        <dc:Bounds x="1415" y="180" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Booked_di" bpmnElement="End_Booked">
        <dc:Bounds x="1592" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1565" y="242" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NoSlot_di" bpmnElement="Task_NoSlot">
