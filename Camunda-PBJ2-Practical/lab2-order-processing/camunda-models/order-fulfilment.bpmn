      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Payment_di" bpmnElement="Task_Payment">
        <dc:Bounds x="1445" y="160" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Payment_di" bpmnElement="Gateway_Payment" isMarkerVisible="true">
        <dc:Bounds x="1625" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1605" y="230" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Declined_di" bpmnElement="End_Declined">
        <dc:Bounds x="1632" y="342" width="36" height="36" />
