        <bpmndi:BPMNLabel><dc:Bounds x="615" y="230" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoStock_di" bpmnElement="End_NoStock">
        <dc:Bounds x="642" y="342" width="36" height="36" />
