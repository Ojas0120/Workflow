      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Total_di" bpmnElement="Task_Total">
        <dc:Bounds x="735" y="160" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Priority_di" bpmnElement="Task_Priority">
        <dc:Bounds x="875" y="160" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HighValue_di" bpmnElement="Gateway_HighValue" isMarkerVisible="true">
        <dc:Bounds x="1045" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1025" y="230" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify">
        <dc:Bounds x="1155" y="70" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Verified_di" bpmnElement="Gateway_Verified" isMarkerVisible="true">
        <dc:Bounds x="1325" y="85" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1305" y="140" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
        <dc:Bounds x="1332" y="2" width="36" height="36" />
